# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URL=mongodb://127.0.0.1:27017/fahmida_portfolio

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=   # `npm run setup` fills this in for you
JWT_EXPIRES_IN=1d

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...)
TRUST_PROXY=0

# "Remember me" login lifetime
JWT_REMEMBER_EXPIRES_IN=7d

# Password-reset emails. Leave SMTP_HOST empty in development: the reset link is
# then printed in this server's console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Used only by `npm run seed:admin`
ADMIN_USERNAME=bristy@gmail.com
ADMIN_NAME=Dr. Fahmida Bristy
ADMIN_EMAIL=bristy@gmail.com
ADMIN_PASSWORD=Bristy123  # initial password only: change it in Dashboard > Account after the first login
